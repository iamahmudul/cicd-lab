{
  "name": "cicd-lab",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/app.test.ts",
    "build": "rimraf dist && tsc && copyfiles -u 1 \"public/**/*\" dist/public && copyfiles -u 2 \"src/views/**/*\" dist/views",
    "start": "node dist/server.js",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "ejs": "^7.0.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "copyfiles": "^2.4.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
